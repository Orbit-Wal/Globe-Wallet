# Stellar network configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Application environment (development, staging, or production)
NEXT_PUBLIC_APP_ENV=development

# Optional server-only override for a custom/private Stellar network
STELLAR_NETWORK_PASSPHRASE=

# Server-only secret key for the account that signs and submits real
# `/api/wallet/send` payments (Issue #63). Must be a funded account's secret
# key (starts with S, 56 chars) on the configured network. NEVER commit a
# real value or expose this to the client — it is only read inside the
# `/api/wallet/send` route handler. Leave unset to have that route respond
# with ERR_PAYMENT_NOT_CONFIGURED instead of fabricating a result.
STELLAR_SOURCE_SECRET_KEY=

# Optional absolute URL for a separately hosted Globe Wallet API
NEXT_PUBLIC_API_BASE_URL=

# Optional secret used to sign JWT access and refresh tokens
AUTH_JWT_SECRET=replace-with-a-long-random-string

# Optional CI-only merge analytics endpoint
MERGE_ANALYTICS_URL=

# ── Soroban contract configuration (optional for mock mode, required for live) ──
# Soroban RPC server URL (e.g. https://soroban-testnet.stellar.org)
SOROBAN_RPC_URL=
# Deployed GlobeWallet contract ID on the target network
SOROBAN_CONTRACT_ID_GLOBE_WALLET=
# Deployed TokenWrapper contract ID (pending upstream implementation)
SOROBAN_CONTRACT_ID_TOKEN_WRAPPER=

# ── EVM chains (Base, Ethereum) — testnet by default ─────────────────────
# Optional RPC overrides. Public defaults (Base Sepolia / Ethereum Sepolia
# via publicnode.com) are used when unset — fine for read-only balance
# checks, but a dedicated provider (Alchemy/Infura/QuickNode) is recommended
# for anything beyond light development use.
BASE_RPC_URL=
ETHEREUM_RPC_URL=

# Server-only private key for the account that signs and submits real
# `/api/evm/send` transactions, mirroring STELLAR_SOURCE_SECRET_KEY above.
# Must be a 32-byte hex private key (0x + 64 hex chars) for a funded testnet
# account. NEVER commit a real value or expose this to the client — it is
# only read inside the `/api/evm/send` route handler. Leave unset to have
# that route respond with ERR_PAYMENT_NOT_CONFIGURED instead of a fabricated
# result.
EVM_SOURCE_PRIVATE_KEY=

# ── Solana (devnet by default) — Issue #142 ───────────────────────────────
# Optional RPC override. Public default (api.devnet.solana.com) is used
# when unset — fine for light development use.
SOLANA_RPC_URL=

# Server-only base58 secret key for the account that signs and submits real
# `/api/solana/send` transactions, mirroring EVM_SOURCE_PRIVATE_KEY above.
# NEVER commit a real value. Leave unset to have that route respond with
# ERR_PAYMENT_NOT_CONFIGURED instead of a fabricated result.
SOLANA_SOURCE_PRIVATE_KEY=

# ── Sui (testnet by default) — Issue #143 ─────────────────────────────────
# Optional RPC override. Public default (fullnode.testnet.sui.io) is used
# when unset — fine for light development use.
SUI_RPC_URL=

# Server-only bech32 "suiprivkey1..." secret key for the account that signs
# and submits real `/api/sui/send` transactions, mirroring
# EVM_SOURCE_PRIVATE_KEY above. NEVER commit a real value. Leave unset to
# have that route respond with ERR_PAYMENT_NOT_CONFIGURED instead of a
# fabricated result.
SUI_SOURCE_PRIVATE_KEY=
